if(TARGET ui_freetype_font_pack)
    set(simulator_text_font "${CMAKE_CURRENT_BINARY_DIR}/product-ui/product-fonts/fonts/text.ttf")
else()
    set(simulator_text_font "${PRODUCT_UI_SOURCE_DIR}/assets/fonts/OPPO_Sans_4.0/OPPO Sans 4.0.ttf")
endif()

add_library(simulator_freetype STATIC src/simulator_fonts.c)
if(TARGET ui_freetype_font_pack)
    add_dependencies(simulator_freetype ui_freetype_font_pack)
endif()
target_compile_definitions(simulator_freetype PRIVATE
    "SIMULATOR_FREETYPE_TEXT_FONT=\"${simulator_text_font}\"")
target_link_libraries(simulator_freetype PRIVATE lvgl lib-ui)

if(BUILD_TESTING)
    add_executable(simulator_freetype_test tests/simulator_freetype_test.c)
    target_include_directories(simulator_freetype_test PRIVATE "${PROJECT_SOURCE_DIR}/src")
    target_link_libraries(simulator_freetype_test PRIVATE simulator_freetype lvgl lib-ui)
    add_test(NAME simulator_freetype COMMAND simulator_freetype_test)
endif()
